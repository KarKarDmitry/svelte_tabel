{
	"name": "test-kadmium-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"deploy": "npm run build && docker compose up -d --build",
		"db:start": "docker compose up",
		"db:start-dev": "docker compose -f compose.dev.yaml up -d",
		"db:seed": "tsx src/lib/server/db/apps/tabel/seed.ts",
		"db:import": "tsx src/lib/server/db/apps/tabel/import/index.ts",
		"db:bootstrap": "tsx src/lib/server/db/bootstrap.ts",
		"db:push": "drizzle-kit push --force",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:stanza-create": "python scripts/db.py stanza-create",
		"db:backup": "python scripts/db.py full",
		"db:backup:diff": "python scripts/db.py diff",
		"db:backup:incr": "python scripts/db.py incr",
		"db:backup:list": "python scripts/db.py list",
		"db:restore": "python scripts/db.py restore",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.28.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/mssql": "^12.3.0",
		"@types/node": "^22",
		"better-auth": "~1.4.21",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"exceljs": "^4.4.0",
		"mssql": "^12.5.4",
		"punycode": "^2.3.1",
		"xlsx": "^0.18.5",
		"xlsx-populate": "^1.21.0"
	}
}
